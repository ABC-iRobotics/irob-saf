<?xml version="1.0"?>
<package format="3">
    <name>irob_subtask_logic</name>
    <version>2.0.0</version>
    <description>
        High-level subtask logic layer of the iRob Surgical Automation Framework (SAF):
        includes autonomous grasping, peg-transfer, cut-vessel, camera and accuracy modules.
        Ported to ROS 2 Jazzy.
    </description>

    <maintainer email="tamas.levendovics@irob.uni-obuda.hu">Tamas Levendovics</maintainer>
    <license>MIT</license>

    <!-- Build tool -->
    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- Core ROS dependencies -->
    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>std_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>stereo_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>Eigen3</depend>

    <!-- iRob framework dependencies -->
    <depend>irob_msgs</depend>
    <depend>irob_utils</depend>
    <depend>irob_motion</depend>
    <depend>irob_robot</depend>
    <depend>irob_vision_support</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
