<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>irob_saf</name>
    <version>2.0.0</version>
    <description>iRob Surgical Automation Framework — Implementation of surgical subtasks</description>

    <maintainer email="tamas.levendovics@irob.uni-obuda.hu">Tamás Levendovics</maintainer>
    <license>MIT</license>

    <!-- ✅ must use ament_cmake_core, not ament_cmake -->
    <buildtool_depend>ament_cmake_core</buildtool_depend>

    <!-- ✅ only exec_depends for subpackages -->
    <exec_depend>irob_msgs</exec_depend>
    <exec_depend>irob_utils</exec_depend>
    <exec_depend>irob_robot</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
        <metapackage/>
    </export>
</package>
