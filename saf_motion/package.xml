<?xml version="1.0"?>
<package format="3">
    <name>saf_motion</name>
    <version>2.0.0</version>
    <description>
        iRob Surgical Automation Framework — motion-level logic and action clients
        (Surgeme client library, server and mimic nodes). ROS 2 Jazzy port.
    </description>

    <maintainer email="tamas.levendovics@irob.uni-obuda.hu">Tamas Levendovics</maintainer>
    <license>MIT</license>

    <!-- Build system -->
    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- Core ROS 2 APIs -->
    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>rcpputils</depend>

    <!-- Messages / geometry -->
    <depend>std_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>

    <!-- TF2 -->
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>

    <!-- Math -->
    <depend>Eigen3</depend>

    <!-- saf framework dependencies -->
    <depend>saf_msgs</depend>
    <depend>saf_utils</depend>
    <depend>saf_robot</depend>

    <!-- Export for downstream packages -->
    <export>
        <build_type>ament_cmake</build_type>

        <!-- Export the CMake target so saf_motion::surgeme_client_lib is discoverable -->
        <build_export_depend>saf_msgs</build_export_depend>
        <build_export_depend>saf_utils</build_export_depend>
        <build_export_depend>saf_robot</build_export_depend>
        <exec_depend>saf_msgs</exec_depend>
        <exec_depend>saf_utils</exec_depend>
        <exec_depend>saf_robot</exec_depend>
    </export>
</package>
