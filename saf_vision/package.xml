<?xml version="1.0"?>
<package format="3">
    <name>saf_vision_support</name>
    <version>2.0.0</version>
    <description>ROS 2 vision utilities for saf SAF: camera preprocessing, dummy vision server/client, target publisher.</description>

    <maintainer email="tamas.levendovics@irob.uni-obuda.hu">Tamas Levendovics</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>visualization_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>saf_utils</depend>
    <depend>Eigen3</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
